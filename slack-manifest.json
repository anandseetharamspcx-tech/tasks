{
  "display_information": {
    "name": "Move Request",
    "description": "Button bot for move requests: Accept or Deny, then Staged or Cancel, then Loaded or Cancel.",
    "background_color": "#1d1c1d"
  },
  "features": {
    "bot_user": {
      "display_name": "Move Request",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/move",
        "description": "Create a move request",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
